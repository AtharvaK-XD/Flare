# ── Generated data (rebuilt by `make bootstrap`) ───────────────────────
# NOTE: backend/data/labels/ is intentionally NOT ignored — the ground-truth
# label set is committed and the eval is meaningless without it.
backend/data/chroma/
backend/data/datasets/
# Stray Chroma segment dirs written when CHROMA_PERSIST_DIR pointed at ./data
backend/data/*/*.bin
*.db
*.sqlite3
# SQLite WAL sidecars
*.db-shm
*.db-wal
*.sqlite3-shm
*.sqlite3-wal

