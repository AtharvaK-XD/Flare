# ── App ───────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# bind host for uvicorn
API_HOST=0.0.0.0
# bind port for uvicorn
API_PORT=8000
# Browser origins allowed to call this API. MUST be a JSON array — a plain
# comma-separated list raises SettingsError and the app will NOT start.
# In APP_ENV=development "*" is appended automatically, so this only matters
# once the frontend is deployed somewhere other than localhost:5173.
CORS_ORIGINS=["http://localhost:5173"]

# ── Groq (LLM) ────────────────────────────────────────────────────────
# get from https://console.groq.com/keys
GROQ_API_KEY=
# low-latency triage model. Groq renames/retires slugs regularly — confirm
# against `GET https://api.groq.com/openai/v1/models` before changing this.
GROQ_FAST_MODEL=llama-3.1-8b-instant
# higher-quality reasoning model
GROQ_QUALITY_MODEL=llama-3.3-70b-versatile

# ── Google Gemini (LLM) ───────────────────────────────────────────────
# get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=
# Gemini model id. Do NOT use gemini-2.0-flash on a free key: it reports
# "limit: 0" and returns a PERMANENT 429 on every call. `make smoke` tells
# permanent-zero-quota apart from an ordinary rate limit.
GEMINI_MODEL=gemini-flash-latest

# ── Threat intel providers ────────────────────────────────────────────
# get from https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=
# get from https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=
# VirusTotal free tier: 4 req/min
VT_RATE_LIMIT_PER_MIN=4
# AbuseIPDB free tier: 1000 checks/day
ABUSEIPDB_RATE_LIMIT_PER_DAY=1000
# cache intel lookups for 24h (seconds)
INTEL_CACHE_TTL_SECONDS=86400

# ── Persistence ───────────────────────────────────────────────────────
# async SQLAlchemy URL
DATABASE_URL=sqlite+aiosqlite:///./data/flare.db

# ── Vector store (Chroma) ─────────────────────────────────────────────
# on-disk persist directory
CHROMA_PERSIST_DIR=./data/chroma
# collection name
CHROMA_COLLECTION=mitre_attack
# HF embedding model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ── Datasets / evaluation ─────────────────────────────────────────────
# raw dataset dir
DATASET_PATH=./data/datasets
# ground-truth labels dir (committed: data/labels/cicids2017_labeled_subset.csv)
GROUND_TRUTH_PATH=./data/labels
# warn LOUDLY below this many labeled rows — an eval on a handful of rows
# produces real-looking numbers that mean nothing
EVAL_MIN_LABEL_ROWS=50
# an eval/benchmark row stuck in status=running longer than this is presumed
# crashed, marked failed, and stops blocking the next POST /run
RUN_STALE_TIMEOUT_SECONDS=300

# ── Replay / workers ──────────────────────────────────────────────────
# event replay throttle
REPLAY_EVENTS_PER_SECOND=10
# concurrent triage workers
TRIAGE_WORKER_CONCURRENCY=1
# concurrent enrichment workers
ENRICH_WORKER_CONCURRENCY=1

# ── Triage tuning ─────────────────────────────────────────────────────
# worst IOC score (0-100) at or above which threat intel overrides the model's
# severity and upgrades the alert to `high`
IOC_ESCALATION_SCORE=80
# also enrich low/info alerts that carry public IOCs (costs intel quota)
ENRICH_LOW_SEVERITY=false
# wall-clock budget for one full classify->recommend run, seconds
TRIAGE_TIMEOUT_SECONDS=120
# preload the sentence-transformers model in the background at boot (~34s cold);
# without it the first alert pays the cost inside the retrieve node
WARM_EMBEDDING_MODEL_ON_STARTUP=true

# ── Evaluation / benchmark sizing ─────────────────────────────────────
# default sample when POST /evaluation/run omits sample_size
EVAL_SAMPLE_SIZE=200
# hard cap; a larger request is refused with 400, never silently truncated
EVAL_MAX_SAMPLE_SIZE=2000
EVAL_CONCURRENCY=4
# fixed seed => two runs draw the same stratified sample
EVAL_SEED=20260725
# skip enrichment during eval (200 alerts through VirusTotal at 4/min is ~50 min)
EVAL_SKIP_ENRICH=true
# every benchmark alert is run through BOTH tiers, so 25 samples = 50 LLM calls
BENCHMARK_SAMPLE_SIZE=25
BENCHMARK_MAX_SAMPLE=50
BENCHMARK_WARMUP=2

# ── Feature flags ─────────────────────────────────────────────────────
# true to enable benchmark instrumentation
ENABLE_BENCHMARK_MODE=false
# true to run the whole pipeline with deterministic in-process stand-ins for
# every network leaf (LLM tiers, intel sources, embeddings). Same graph, same
# workers, same DB, same API — no network. Use for a demo on dead venue wifi:
#   make dev-offline      (or OFFLINE_MODE=true make dev)
OFFLINE_MODE=false
